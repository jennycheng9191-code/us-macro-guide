  "ism_manufacturing_employment":    {"source":"news","keys":["ISM manufacturing employment"],"display":"level","unit":"","decimals":1,"stale_days":40,"sanity":{"min":25,"max":75},"rules":["pmi_50_line"]},
  "ism_services_employment":         {"source":"news","keys":["ISM services employment"],"display":"level","unit":"","decimals":1,"stale_days":40,"sanity":{"min":25,"max":75},"rules":["pmi_50_line"]},

