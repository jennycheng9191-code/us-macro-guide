  "existing_home_sales":             {"source":"fred","series":"EXHOSLUSM495S","display":"level","scale":0.001,"unit":"千戶(年化)","decimals":0,"stale_days":45,"sanity":{"min":3000,"max":8000},"note":"FRED 原始單位為『戶』，已換算為千戶"},
