  "core_services_ex_housing":        {"source":"fred","series":"CUSR0000SASL2RS","bond_dir":1,"display":"yoy","also":["ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-3,"max":15},"note":"FRED 官方『服務業扣除房租』序列，即 Super Core 的標準代理"},
  "owners_equivalent_rent_rent":     {"source":"fred","series":"CUSR0000SEHC","bond_dir":1,"display":"yoy","also":["ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-2,"max":12}},
