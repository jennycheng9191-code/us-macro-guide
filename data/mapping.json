  "survey_of_consumer_expectations":  {"source":"nyfed_sce","url":"https://www.newyorkfed.org/medialibrary/interactives/sce/sce/downloads/data/frbny-sce-data.xlsx","field":"3年期中位數","display":"level","unit":"%","decimals":2,"stale_days":45,"sanity":{"min":0,"max":10}},
  "umich_inflation_expectations":    {"source":"fred","series":"MICH","display":"level","unit":"%","decimals":1,"stale_days":45,"sanity":{"min":0,"max":12},"note":"MICH 為 1 年期預期；5–10 年期 FRED 無對應序列"},

  "nonfarm_payrolls":                {"source":"fred","series":"PAYEMS","display":"mom_diff","unit":"千人","decimals":0,"stale_days":40,"sanity":{"min":-2000,"max":2000},"rules":["breakeven_100_150"]},
