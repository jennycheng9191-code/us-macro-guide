  "nahb_housing_market_index":       {"source":"html","url":"https://www.nahb.org/news-and-economics/housing-economics/indices/housing-market-index","pattern":"hmi_key_findings","display":"level","unit":"","decimals":0,"stale_days":40,"sanity":{"min":5,"max":90},"rules":["pmi_50_line"],"note":"2026-08-02 實測：HMI Key Findings 段落含數字，另附 .xls 歷史檔"},
