  "labor_force_participation_rate":  {"source":"fred","series":"CIVPART","extras":{"25-54歲":"LNS11300060"},"display":"level","unit":"%","decimals":1,"stale_days":40,"sanity":{"min":55,"max":70}},
  "average_hourly_earnings":         {"source":"fred","series":"CES0500000003","display":"yoy","also":["mom"],"unit":"%","decimals":1,"stale_days":40,"sanity":{"min":-2,"max":12},"rules":["wage_compat_3_0_3_5"]},
  "job_openings_and_labor_turnover_survey": {"source":"fred","series":"JTSJOL","extras":{"離職率":"JTSQUR","失業人數":"UNEMPLOY"},"display":"level","unit":"千個","decimals":0,"stale_days":75,"sanity":{"min":3000,"max":13000},"rules":["v_u_ratio"],"note":"JOLTS 本身滯後約 2 個月，stale_days 已放寬"},
  "initial_jobless_claims":          {"source":"fred","series":"ICSA","extras":{"續領":"CCSA"},"display":"level","also":["ma4"],"unit":"人","decimals":0,"stale_days":12,"sanity":{"min":150000,"max":1500000},"rules":["claims_range_break"]},
