  "ism_mfg_new_orders":              {"source":"news","keys":["ISM manufacturing new orders"],"display":"level","unit":"","decimals":1,"stale_days":40,"sanity":{"min":20,"max":80},"rules":["pmi_50_line"]},
  "ism_mfg_prices_paid":             {"source":"news","keys":["ISM manufacturing prices paid","prices paid index"],"display":"level","unit":"","decimals":1,"stale_days":40,"sanity":{"min":20,"max":95},"rules":["pmi_50_line"]},
  "ism_services_pmi":                {"source":"news","keys":["ISM services PMI","services PMI"],"display":"level","unit":"","decimals":1,"stale_days":40,"sanity":{"min":25,"max":75},"rules":["pmi_50_line"]},

  "retail_sales_advance":            {"source":"fred","series":"RSAFS","extras":{"扣除餐飲":"RSXFS"},"display":"yoy","also":["mom"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-25,"max":30}},
  "industrial_production":           {"source":"fred","series":"INDPRO","extras":{"產能利用率":"TCU"},"display":"yoy","also":["mom"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-20,"max":20}},
  "atlanta_fed_gdpnow":              {"source":"fred","series":"GDPNOW","display":"level","unit":"%","decimals":1,"stale_days":14,"sanity":{"min":-10,"max":12}},
  "durable_goods_orders":            {"source":"fred","series":"DGORDER","extras":{"核心資本財":"NEWORDER"},"display":"yoy","also":["mom"],"unit":"%","decimals":1,"stale_days":50,"sanity":{"min":-40,"max":40}},

