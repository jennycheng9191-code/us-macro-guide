{
  "_doc": {
    "說明": "47 張卡的資料來源映射表。所有 FRED 序列代號已於 2026-08-02 逐一透過 FRED API 驗證存在且仍在更新。",
    "source 型別": {
      "fred": "FRED API，需 FRED_API_KEY",
      "derived": "由多個 FRED 序列計算得出",
      "nyfed_sce": "NY Fed 消費者預期調查 xlsx",
      "treasury": "Treasury FiscalData / TreasuryDirect API，免金鑰",
      "html": "解析官方網頁 HTML",
      "news": "CNBC + AP 雙來源，須過三道關卡",
      "manual": "人工輸入（data/manual.json），依行事曆提醒"
    },
    "display": "level=原值 | yoy=年增率 | mom=月變動 | mom_diff=月變動絕對量 | ann3m=3個月年化",
    "stale_days": "超過此天數未更新即亮黃燈（含資料本身的發布滯後）"
  },

  "consumer_price_index":            {"source":"fred","series":"CPIAUCSL","display":"yoy","also":["mom","ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-3,"max":20}},
  "core_cpi_ex_food_energy":         {"source":"fred","series":"CPILFESL","display":"yoy","also":["mom","ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-2,"max":15},"rules":["core_vs_target"]},
  "core_services_ex_housing":        {"source":"fred","series":"CUSR0000SASL2RS","display":"yoy","also":["ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-3,"max":15},"note":"FRED 官方『服務業扣除房租』序列，即 Super Core 的標準代理"},
  "owners_equivalent_rent_rent":     {"source":"fred","series":"CUSR0000SEHC","display":"yoy","also":["ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-2,"max":12}},
  "pce_price_index":                 {"source":"fred","series":"PCEPILFE","extras":{"總指數":"PCEPI"},"display":"yoy","also":["mom","ann3m"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-2,"max":12}},
  "dallas_fed_trimmed_mean_pce":     {"source":"fred","series":"PCETRIM12M159SFRBDAL","extras":{"單月年化":"PCETRIM1M158SFRBDAL"},"display":"level","unit":"%","decimals":2,"stale_days":50,"sanity":{"min":-2,"max":12}},
  "producer_price_index":            {"source":"fred","series":"PPIFIS","display":"yoy","also":["mom"],"unit":"%","decimals":1,"stale_days":45,"sanity":{"min":-8,"max":20}},
