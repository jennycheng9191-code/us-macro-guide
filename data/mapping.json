  "5_year_5_year_forward_inflation_expectat": {"source":"fred","series":"T5YIFR","bond_dir":1,"display":"level","unit":"%","decimals":2,"stale_days":5,"sanity":{"min":0,"max":5},"rules":["deanchor_2_5"]},
