  "_doc": {
    "說明": "47 張卡的資料來源映射表。所有 FRED 序列代號已於 2026-08-02 逐一透過 FRED API 驗證存在且仍在更新。",
    "source 型別": {
      "fred": "FRED API，需 FRED_API_KEY",
      "derived": "由多個 FRED 序列計算得出",
      "nyfed_sce": "NY Fed 消費者預期調查 xlsx",
      "treasury": "Treasury FiscalData / TreasuryDirect API，免金鑰",
      "html": "解析官方網頁 HTML",
      "news": "CNBC + AP 雙來源，須過三道關卡",
      "manual": "人工輸入（data/manual.json），依行事曆提醒"
    },
    "display": "level=原值 | yoy=年增率 | mom=月變動 | mom_diff=月變動絕對量 | ann3m=3個月年化",
    "stale_days": "超過此天數未更新即亮黃燈（含資料本身的發布滯後）"
  },

